dial = 50
result = 0

with open(r"Input.txt", "r") as note, open("wynik.txt", "w") as wyjscie:
    for line in note:
        print("the current line is:", line.strip())
        wyjscie.write(f"the current line is: {line.strip()} \n")

        if line.strip()[0] == "L":
            dial = (dial + -1*int(line[1:])+100)%100
        else:
            dial = (dial + int(line[1:])+100)%100
        print("the current dial is:", dial)
        wyjscie.write(f"the current dial is: {dial} \n")

        if dial == 0:
            result+=1
        
        print("the current result is:",result)
        wyjscie.write(f"the current result is: {result} \n")
